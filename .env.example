# Collector (GitHub Actions secrets in production; export locally to use Supabase instead of SQLite)
GH_TOKEN=                      # fine-grained token, public repos read-only; local runs fall back to `gh auth token`
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=     # server-side only, never in the browser
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RADAR_SITE_URL=https://your-radar.vercel.app
RADAR_ALERT_THRESHOLD=0.75
RADAR_QUIET_START=0            # IST hour
RADAR_QUIET_END=7
